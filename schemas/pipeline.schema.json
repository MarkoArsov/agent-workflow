{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline task",
  "description": "An approved plan with explicit repository access, executable outcomes, ordered stages, and provider routes.",
  "type": "object",
  "required": [
    "schema_version",
    "task",
    "plan_files",
    "repositories",
    "stages",
    "checks",
    "outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "plan_files": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Required prompt.md, requirements.md, implementation.md, deferred.md relative to this manifest."
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Task repository",
        "description": "Explicit participation.",
        "type": "object",
        "required": [
          "id",
          "access"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "access": {
            "enum": [
              "read",
              "write"
            ]
          },
          "branch": {
            "type": "string"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true,
      "description": "implement-tests? -> implement -> review? -> commit-and-push? -> draft-pr?; declared custom stages precede publication."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "Check",
        "description": "Observed acceptance evidence.",
        "type": "object",
        "required": [
          "id",
          "repository",
          "command"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "command": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "required": [
                  "argv"
                ],
                "properties": {
                  "argv": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "timeout_seconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 86400
                  },
                  "env": {
                    "type": "object"
                  },
                  "env_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            ]
          },
          "parser": {
            "enum": [
              "unittest",
              "pytest",
              "dotnet",
              "jest",
              "tap",
              "generic"
            ]
          },
          "identities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "phases": {
            "type": "array",
            "items": {
              "enum": [
                "red",
                "green"
              ]
            }
          },
          "success_pattern": {
            "type": "string"
          },
          "failure_pattern": {
            "type": "string"
          },
          "approved_skip_reason": {
            "type": "string"
          },
          "environment": {
            "type": "string",
            "description": "Named project environment started and cleaned up around checks."
          }
        },
        "additionalProperties": true
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "checks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "provider",
            "model"
          ],
          "properties": {
            "provider": {
              "enum": [
                "claude",
                "codex",
                "cursor"
              ]
            },
            "model": {
              "type": "string"
            },
            "reasoning": {
              "type": "string"
            }
          }
        }
      }
    },
    "limits": {
      "type": "object"
    },
    "delivery": {
      "type": "object"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "connectors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
