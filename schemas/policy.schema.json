{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed plovi policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "running_tasks": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "waiting_for_review": {
          "default": 3,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "attempts_per_stage": {
          "default": 2,
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "max_changed_files": {
          "default": 40,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "max_changed_lines": {
          "default": 1500,
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "size_exempt": {
          "default": [
            "**/package-lock.json",
            "**/*.lock"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+"
          }
        }
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protected": {
          "default": [
            ".github/workflows/**",
            "**/migrations/**"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)(?!.*\\\\).+"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unattended_permission_mode": {
          "default": "restricted",
          "enum": [
            "restricted",
            "trusted"
          ]
        },
        "tracking_mode": {
          "type": "string",
          "enum": [
            "auto",
            "current-terminal",
            "app-terminal",
            "command-only",
            "off"
          ],
          "default": "auto"
        },
        "require_plan_approval": {
          "type": "boolean",
          "default": true,
          "description": "Background workers start only a plan whose current hash has a recorded approval."
        }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "default": "assisted",
          "enum": [
            "assisted",
            "ready",
            "auto"
          ]
        }
      }
    },
    "grants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "container"
          ],
          "default": "none"
        },
        "runtime": {
          "enum": [
            "auto",
            "docker",
            "podman"
          ],
          "default": "auto"
        },
        "image": {
          "type": "string",
          "default": "",
          "maxLength": 512,
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._/@:+-]*$"
        },
        "network": {
          "enum": [
            "on",
            "off"
          ],
          "default": "on"
        },
        "mount_harness_config": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "codex",
              "claude",
              "cursor"
            ]
          },
          "default": []
        },
        "api_key_env": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "default": []
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "container"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "image"
            ],
            "properties": {
              "image": {
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
