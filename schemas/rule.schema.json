{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped project rule",
  "description": "Deterministic blocking checks, advisory signals, or contextual prose. Recurrence triggers review.",
  "type": "object",
  "required": [
    "id",
    "guidance",
    "enforcement"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "guidance": {
      "type": "string"
    },
    "enforcement": {
      "enum": [
        "blocking",
        "advisory",
        "prose"
      ]
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "command": {
      "type": "object",
      "required": [
        "argv"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "env": {
          "type": "object"
        },
        "env_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "forbidden_pattern": {
      "type": "string"
    },
    "review_after": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "enforcement": {
            "const": "blocking"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "command"
            ]
          },
          {
            "required": [
              "forbidden_pattern"
            ]
          }
        ]
      }
    }
  ]
}
